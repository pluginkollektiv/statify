{
  "name": "pluginkollektiv/statify",
  "description": "Compact, easy-to-use and privacy-compliant stats plugin for WordPress.",
  "license": "GPL-3.0-or-later",
  "type": "wordpress-plugin",
  "keywords": [
    "wordpress",
    "plugin",
    "statistics"
  ],
  "require": {
    "php": "^7.4|^8",
    "jaybizzle/crawler-detect": "^1.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
    "doctrine/instantiator": "^1.5",
    "matthiasmullie/minify": "^1.3",
    "myclabs/deep-copy": "1.13.4",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9",
    "slowprog/composer-copy-file": "^0.3",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "scripts": {
    "post-install-cmd": [
      "@build"
    ],
    "post-update-cmd": [
      "@build"
    ],
    "build": [
      "@copy-assets"
    ],
    "copy-assets": [
      "SlowProg\\CopyFile\\ScriptHandler::copy"
    ],
    "csfix": [
      "phpcbf --standard=phpcs.xml"
    ],
    "lint-php": [
      "phpcs --standard=phpcs.xml -s"
    ],
    "lint-tests": [
      "phpcs --standard=tests/phpcs.xml tests"
    ],
    "phpstan": [
      "phpstan analyse --memory-limit=1G"
    ],
    "test": [
      "phpunit"
    ]
  },
  "extra": {
    "copy-file": {
      "vendor/jaybizzle/crawler-detect/src/": "lib/Jaybizzle/CrawlerDetect/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
